{
   "main": "out/main/index.js",
   "name": "email-client",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "packageManager": "pnpm@12.4.2",
   "scripts": {
      "electron_fix": "node ./node_modules/electron/install.js"
   },
   "dependencies": {
      "@emotion/react": "^11.14.0",
      "@emotion/styled": "^11.14.1",
      "@fontsource/inter": "^5.3.0",
      "@mui/joy": "5.0.0-beta.52",
      "imapflow": "^1.7.8",
      "nodemailer": "^6.10.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.3",
      "@types/node": "^24.13.3",
      "@types/nodemailer": "^8.0.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "@vitejs/plugin-react": "^6.1.1",
      "concurrently": "^10.0.6",
      "electron": "^44.9.0",
      "electron-builder": "^26.15.3",
      "electron-vite": "^6.0.0",
      "eslint": "^10.10.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.6",
      "globals": "^17.12.0",
      "jsdom": "^30.1.3",
      "tsx": "^4.23.15",
      "typescript": "~6.0.2",
      "typescript-eslint": "^8.69.0",
      "vite": "^8.3.0",
      "vitest": "^5.0.5"
   },
   "build": {
      "appId": "com.cs3141team11.emailclient",
      "productName": "Email Client",
      "directories": {
         "output": "release"
      },
      "files": [
         "out/**/*",
         "package.json"
      ],
      "extraResources": [
         {
            "from": "src/main/desktop_assets",
            "to": "desktop_assets"
         }
      ],
      "win": {
         "icon": "src/main/desktop_assets/icon.ico",
         "target": "nsis"
      },
      "mac": {
         "target": "dmg"
      },
      "linux": {
         "target": "AppImage"
      }
   }
}
