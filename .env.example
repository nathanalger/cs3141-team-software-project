IMAP_HOST=imap.example.test
IMAP_PORT=993
IMAP_USER=your-test-user
IMAP_PASSWORD=your-test-password

SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=your-test-user
SMTP_PASSWORD=your-test-password

# Optional: address displayed as sender; defaults to SMTP_USER.
SMTP_FROM=your-test-user@example.test

# Optional: mailbox fetched by inbox; defaults to INBOX.
IMAP_MAILBOX=INBOX
