{
   "nodeModulesDir": "auto",
   "tasks": {
      "install": "pnpm install",
      "electron_fix": "node ./node_modules/electron/install.js",
      "dev": {
         "description": "Install dependencies, install Electron runtime, and start the API and desktop app",
         "dependencies": ["install", "electron_fix"],
         "command": "deno task client"
      },
      "client": "electron-vite dev",
      "build": "electron-vite build",
      "preview": "electron-vite preview",
      "package": "deno task build && electron-builder",
      "test": "vitest run",
      "test:watch": "vitest"
   },
   "allowScripts": {
      "allow": ["npm:electron-winstaller@5.4.0", "npm:esbuild@0.28.2","npm:pnpm"],
      "deny": []
   }
}
